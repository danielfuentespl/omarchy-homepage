#!/usr/bin/env bash
set +x
set -euo pipefail

secret_id=${1:-default}
if [[ ! "$secret_id" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; then
  printf '%s\n' 'Secret ID must use 1–64 letters, digits, dots, underscores or hyphens.' >&2
  exit 2
fi
if ! command -v secret-tool >/dev/null 2>&1; then
  printf '%s\n' 'secret-tool is required (install libsecret and a Secret Service provider).' >&2
  exit 127
fi
if [[ ! -r /dev/tty ]]; then
  printf '%s\n' 'Run this command from an interactive terminal.' >&2
  exit 2
fi
printf 'Homepage MCP token: ' >/dev/tty
IFS= read -r -s token </dev/tty
printf '\n' >/dev/tty
if [[ ${#token} -lt 32 || ! "$token" =~ ^[A-Za-z0-9_+/=-]+$ ]]; then
  unset token
  printf '%s\n' 'Token must contain at least 32 supported token characters.' >&2
  exit 2
fi
printf '%s' "$token" | secret-tool store --label='OmaHomepage MCP token' \
  application omaops-homepage instance "$secret_id" >/dev/null
unset token
printf 'Homepage MCP token stored in Secret Service (ID: %s).\n' "$secret_id"
